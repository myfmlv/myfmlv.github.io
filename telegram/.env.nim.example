# Telegram briefing optional LLM / NVIDIA NIM example
#
# 기본 권장:
# - daily core는 rule-based 유지
# - daily LLM synthesis는 필요할 때만 켠다
# - weekly/monthly digest는 NIM으로 붙여도 된다

# Global fallback backend
TELEGRAM_LLM_BACKEND=nim

# NVIDIA NIM connection
TELEGRAM_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
TELEGRAM_NIM_API_KEY=YOUR_NVIDIA_NIM_API_KEY
TELEGRAM_NIM_TIMEOUT_SECONDS=90

# Conservative mode: keep daily rule-based, use NIM only for digest
TELEGRAM_BRIEFING_USE_LLM=0
TELEGRAM_BRIEFING_LLM_BACKEND=nim
TELEGRAM_BRIEFING_SYNTHESIS_MODEL=meta/llama-3.1-70b-instruct
TELEGRAM_BRIEFING_SYNTHESIS_REASONING_EFFORT=low

TELEGRAM_DIGEST_USE_LLM=1
TELEGRAM_DIGEST_LLM_BACKEND=nim
TELEGRAM_DIGEST_ANALYSIS_MODEL=meta/llama-3.1-70b-instruct
TELEGRAM_DIGEST_SYNTHESIS_MODEL=meta/llama-3.1-70b-instruct
TELEGRAM_DIGEST_REASONING_EFFORT=low

# If you want daily optional rewrite/synthesis too, switch this to 1.
# TELEGRAM_BRIEFING_USE_LLM=1

# Telegram delivery envs are still required separately.
# TELEGRAM_BOT_TOKEN=...
# TELEGRAM_BOT_CHAT_ID=...
